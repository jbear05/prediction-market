# Copy this file to .env (same folder) and fill in the values. Never commit .env.

# development on local, production on the server
NODE_ENV=development
PORT=5000

# the predictionmarket_dev connection string, ask me (Jair) for it.
MONGODB_URI=

# Any long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional on local (defaults to AdminPass123!). Required on the server for npm run seed.
SEED_ADMIN_PASSWORD=